<Configuration>
  <vGPU>Disable</vGPU>
  <Networking>Enable</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <ProtectedClient>Enable</ProtectedClient>
  <MemoryInMB>4096</MemoryInMB>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -NoExit -File C:\RelayReviewPayload\setup-reviewer-sandbox-guest.ps1</Command>
  </LogonCommand>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>%LOCALAPPDATA%\ProjectRelayReviewerDemo\Payload</HostFolder>
      <SandboxFolder>C:\RelayReviewPayload</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
</Configuration>
